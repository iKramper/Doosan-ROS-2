<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="e0509">

    <xacro:include filename="$(find doosan_description)/urdf/e0509.urdf"/>
    <xacro:arg name="controller" default="ros_controller"/>

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>

        <!-- SEVENTH AXIS -->
        <joint name="joint_seventh_axis">
            <command_interface name="position">
                <param name="min">-0.4</param>
                <param name="max">0.4</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- JOINT 1 -->
        <joint name="joint_1">
            <command_interface name="position">
                <param name="min">-6.2832</param>
                <param name="max">6.2832</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- JOINT 2 -->
        <joint name="joint_2">
            <command_interface name="position">
                <param name="min">-6.2832</param>
                <param name="max">6.2832</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- JOINT 3 -->
        <joint name="joint_3">
            <command_interface name="position">
                <param name="min">-2.7053</param>
                <param name="max">2.7053</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- JOINT 4 -->
        <joint name="joint_4">
            <command_interface name="position">
                <param name="min">-6.2832</param>
                <param name="max">6.2832</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- JOINT 5 -->
        <joint name="joint_5">
            <command_interface name="position">
                <param name="min">-6.2832</param>
                <param name="max">6.2832</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- JOINT 6 -->
        <joint name="joint_6">
            <command_interface name="position">
                <param name="min">-6.2832</param>
                <param name="max">6.2832</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

</robot>